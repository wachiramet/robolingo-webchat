# Explicit local UI demo. Set false to enable the real integration.
DEMO_MODE=true
# Live mode requires ALL values below. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Public Messaging API channel identifier (informational).
LINE_CHANNEL_ID=2011541329
# At least 12 characters; use a unique strong password.
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Exact public origin, without a path. HTTPS required in production.
APP_URL=http://localhost:3000
